#!/usr/bin/env bash

ws="${1}"
target=$(aerospace list-monitors --focused --format '%{monitor-id}')

if [ -z "$(aerospace list-windows --workspace "${ws}" --format '%{window-id}')" ]; then
  aerospace move-node-to-workspace "${ws}" --focus-follows-window
  aerospace move-workspace-to-monitor "${target}"
else
  aerospace move-node-to-workspace "${ws}"
fi
