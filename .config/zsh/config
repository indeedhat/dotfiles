# vi mode with cursor shape: block in command mode, beam in insert mode
bindkey -v
export KEYTIMEOUT=1
zle-keymap-select() {
    if [[ $KEYMAP == vicmd ]]; then
        printf '\e[2 q'
    else
        printf '\e[6 q'
    fi
}
zle-line-init() { printf '\e[6 q' }
zle -N zle-keymap-select
zle -N zle-line-init

# <esc>v opens the current command in $EDITOR, as in bash's vi mode
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd v edit-command-line

HISTFILE=~/.zsh_history
HISTSIZE=3000
SAVEHIST=5000
setopt hist_ignore_dups share_history

autoload -Uz compinit && compinit
