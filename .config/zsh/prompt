# Escape % so values are not read as prompt sequences
_ps_esc() { print -rn -- "${1//\%/%%}" }

_ps_symbol() { print -rn -- "%{"$'\e[2m'"%}${1}%{"$'\e[0m'"%}" }

_ps_string() { print -rn -- "%F{cyan}\"${1}\"%f" }

_ps_method() {
    local nl=$'\n    '
    [[ -n "$3" ]] && nl=''
    print -rn -- "$(_ps_symbol '.')${nl}%F{blue}${1}%f$(_ps_symbol '(')$(_ps_string "${2}")$(_ps_symbol ')')"
}

_ps_git_branch() {
    local branch=$(git branch --show-current 2> /dev/null)
    [[ -z "$branch" ]] && return 0
    _ps_method Git "$(_ps_esc "$branch")"
}

_ps_podctl_def() {
    [[ -f ".podctl.toml" ]] || return 0
    local name=$(grep "\bname\b" .podctl.toml | awk -F'"' '{ print $2 }')
    local namespace=$(grep "\bnamespace\b" .podctl.toml | awk -F'"' '{ print $2 }')
    _ps_method PodCTL "$(_ps_esc "${namespace}.${name}")"
}

_ps_go_mod_def() {
    (( $+commands[go] )) || return 0
    local mod=$(go env GOMOD)
    [[ -z "$mod" || "$mod" == "/dev/null" ]] && return 0
    mod=$(grep module "$mod" | awk '{ print $2 }')
    _ps_method GoModule "$(_ps_esc "$mod")"
}

_ps_go_work_def() {
    (( $+commands[go] )) || return 0
    local work=$(go env GOWORK)
    [[ -z "$work" || "$work" == "off" ]] && return 0
    _ps_method GoWorkspace "$(_ps_esc "${${work:h}:t}")"
}

_ps_venv_def() {
    [[ -z "$VIRTUAL_ENV" ]] && return 0
    _ps_method PythonVenv "$(_ps_esc "$VIRTUAL_ENV")"
}

_ps_k8s_def() {
    (( $+commands[kubectl] )) || return 0
    local k8s=$(kubectl config current-context 2> /dev/null | awk -F'/' '{ print $2 }')
    [[ -z "$k8s" ]] && return 0
    _ps_method K8sContext "$(_ps_esc "$k8s")"
}

_ps_build() {
    # terminal title: current directory name
    print -n "\e]0;${PWD:t}\a"
    PROMPT=$'\n'"%n$(_ps_method Dir '%~' true)$(_ps_venv_def)$(_ps_git_branch)$(_ps_k8s_def)$(_ps_go_work_def)$(_ps_go_mod_def)"$'\n'
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd _ps_build

