gh_clone()
{
    cd ~/projects
    git clone git@github.com:$1
    if [ $? -eq 1 ]; then
        cd ${1##*/}
        nvim
    fi
}


cd() {
    builtin cd "$@" && automux 
}

alias iwdfix="sudo systemctl restart iwd"

json()
{
    wl-paste | jq "$@"
}

yaml()
{
    wl-paste | yq "$@"
}

jwt()
{
    wl-paste | jq -R 'split(".") | .[1] | @base64d | fromjson'
}

